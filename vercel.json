{
  "rewrites": [
    {
      "source": "/build/(.*\\.wasm)",
      "destination": "https://github.com/shahmirkhan2005/cricket07-browser/releases/download/v1/cricket07.06b94ea160aa.wasm"
    },
    {
      "source": "/build/(.*)",
      "destination": "/build/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
