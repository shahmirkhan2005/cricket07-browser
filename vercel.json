{
  "rewrites": [
    {
      "source": "/build/(.*\\.wasm)",
      "destination": "https://cricket07-netplay.shahmirkhan1april.workers.dev/recomp.wasm"
    },
    {
      "source": "/build/(.*)",
      "destination": "/web/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
