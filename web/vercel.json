{
  "rewrites": [
    {
      "source": "/build/(.*\\.wasm)",
      "destination": "https://github.com"
    },
    {
      "source": "/build/(.*)",
      "destination": "/web/build/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
